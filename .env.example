# ─────────────────────────────────────────────────────────────────────────────
#  این فایل را به .env کپی کنید و مقادیر را پر کنید (اختیاری، فقط برای build)
#  هیچ‌کدام از این مقادیر محرمانه نیستند؛ کلیدهای محرمانهٔ GitHub OAuth را
#  هرگز اینجا نگذارید — آن‌ها فقط در متغیرهای محیطی Cloudflare Pages قرار می‌گیرند.
# ─────────────────────────────────────────────────────────────────────────────

# آدرس نهایی سایت (بدون / در انتها)
SITE_URL=https://khakneh.pages.dev

# فقط اگر سایت در زیرمسیر منتشر می‌شود (مثلاً GitHub Pages: /portfolio)
# BASE_PATH=/portfolio

# مخزن و شاخه‌ای که CMS در آن کامیت می‌کند
CMS_REPO=dirakokha/portfolio
CMS_BRANCH=main

# آدرس پروکسی ورود. پیش‌فرض: ${SITE_URL}/api
# OAUTH_BASE_URL=https://khakneh.pages.dev/api
