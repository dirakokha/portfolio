---
import { contact, publicPhone, socialLinks } from '../lib/content';
import { asset, formatPhone, mailtoHref, telHref } from '../lib/urls';

interface Props {
  index: number;
}
const { index } = Astro.props;
const mailTo = mailtoHref(contact.email, contact.email_subject);
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-tone="dark">
  <div class="wrap">
    <div class="contact__head">
      <h2 class="contact__title" id="contact-title">تماس</h2>
      {contact.response_note && <p class="contact__note">{contact.response_note}</p>}
    </div>

    <a class="contact__email" href={mailTo}>{contact.email}</a>

    <div class="contact__actions">
      <a class="btn" href={mailTo}>
        نوشتن ایمیل
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12v8H2z" stroke="currentColor" stroke-width="1.3"></path>
          <path d="m2.4 4.4 5.6 4 5.6-4" stroke="currentColor" stroke-width="1.3"></path>
        </svg>
      </a>
      <a class="link-line" href={asset('/resume/')}>نسخهٔ چاپی / PDF</a>
    </div>

    <dl class="contact__grid">
      {contact.location_label && (
        <div>
          <dt>محل</dt>
          <dd>{contact.location_label}</dd>
        </div>
      )}
      {contact.availability && (
        <div>
          <dt>نوع همکاری</dt>
          <dd>{contact.availability}</dd>
        </div>
      )}
      {publicPhone && (
        <div>
          <dt>تلفن</dt>
          <dd dir="ltr">
            <a class="link-line" href={telHref(publicPhone)}>{formatPhone(publicPhone)}</a>
          </dd>
        </div>
      )}
      {socialLinks.length > 0 && (
        <div>
          <dt>شبکه‌ها</dt>
          <dd>
            {socialLinks.map((social) => (
              <a class="link-line" href={social.url} rel="noopener noreferrer me" target="_blank">
                {social.label || social.handle}
              </a>
            ))}
          </dd>
        </div>
      )}
    </dl>
  </div>
</section>
