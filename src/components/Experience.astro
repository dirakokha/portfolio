---
import { experience } from '../lib/content';
import SectionHead from './SectionHead.astro';
import { fa } from '../lib/digits';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="experience-heading">
  <div class="wrap section__grid">
    <SectionHead
      index={index}
      title="تجربه"
      id="experience-heading"
      aside="تجربهٔ کاری واقعی، با همان اندازهٔ واقعی‌اش."
    />

    <div class="section__body">
      {
        experience.items.map((job) => {
          const dates = [job.start_label, job.end_label && job.end_label !== job.start_label ? job.end_label : '']
            .filter(Boolean)
            .join(' — ');
          const meta = [job.duration_label, job.employment, job.location].filter(Boolean);
          return (
            <article class="job" data-reveal>
              <header class="job__head">
                <p class="job__when">
                  {dates && <span class="job__date">{dates}</span>}
                  {meta.length > 0 && <span class="job__meta">{meta.join(' · ')}</span>}
                </p>
                <h3 class="job__org">{job.organization}</h3>
                <p class="job__role">{job.role}</p>
              </header>

              {job.summary && <p class="job__summary">{job.summary}</p>}

              <div class="job__groups">
                {job.groups.map((group, groupIndex) => (
                  <section class="group">
                    <h4 class="group__title">
                      <span aria-hidden="true">{fa(String(groupIndex + 1).padStart(2, '0'))}</span>
                      {group.title}
                    </h4>
                    <ul class="group__list">
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>

              {job.note && (
                <aside class="job__note">
                  <b>یادداشت</b>
                  <p>{job.note}</p>
                </aside>
              )}

              {job.tags.length > 0 && (
                <p class="job__tags" aria-label="واژه‌های کلیدی">
                  {job.tags.join(' · ')}
                </p>
              )}
            </article>
          );
        })
      }
      {
        experience.items.length === 0 && (
          <p class="prose">
            <span>در حال حاضر تجربهٔ کاری ثبت‌شده‌ای برای نمایش وجود ندارد.</span>
          </p>
        )
      }
    </div>
  </div>
</section>
