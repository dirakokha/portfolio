---
import { experience } from '../lib/content';
import EntryHead from './EntryHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="entry" id="experience" aria-labelledby={`head-${index}`} data-entry>
  <div class="wrap entry__grid">
    <EntryHead index={index} title="تجربهٔ کاری" meta="ENTRY / WORK" />

    <div class="entry__body">
      {
        experience.items.map((job) => (
          <article class="job">
            <div class="job__top">
              <div>
                <h3 class="job__org">{job.organization}</h3>
                <p class="job__role">{job.role}</p>
              </div>
              <div class="job__when">
                <span>{job.start_label}</span>
                {job.duration_label && <span>{job.duration_label}</span>}
                {job.employment && <span>{job.employment}</span>}
              </div>
            </div>

            {job.summary && <p class="job__summary">{job.summary}</p>}

            {job.groups.length > 0 && (
              <div class="job__groups">
                {job.groups.map((group) => (
                  <div>
                    <h4>{group.title}</h4>
                    <ul>
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            {job.note && <p class="job__note">{job.note}</p>}

            {job.tags.length > 0 && (
              <ul class="tags">
                {job.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
