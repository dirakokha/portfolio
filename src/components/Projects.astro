---
import { projects } from '../lib/content';
import EntryHead from './EntryHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

{
  projects.length > 0 && (
    <section class="entry" id="projects" aria-labelledby={`head-${index}`} data-entry>
      <div class="wrap entry__grid">
        <EntryHead index={index} title="نمونه‌کارها" meta="ENTRY / WORK OUT" />
        <div class="entry__body">
          <div class="spec">
            {projects.map((project) => (
              <article class="spec__cat">
                <div class="spec__title">
                  <h3>{project.title}</h3>
                  {project.year_label && <p>{project.year_label}</p>}
                </div>
                <div>
                  {project.summary && <p class="job__summary">{project.summary}</p>}
                  {project.technologies.length > 0 && (
                    <ul class="tags">
                      {project.technologies.map((tech) => (
                        <li>{tech}</li>
                      ))}
                    </ul>
                  )}
                  <div class="hero__actions">
                    {project.demo_url && (
                      <a class="link-line" href={project.demo_url} rel="noopener noreferrer" target="_blank">
                        مشاهده
                      </a>
                    )}
                    {project.source_url && (
                      <a class="link-line" href={project.source_url} rel="noopener noreferrer" target="_blank">
                        کد
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
