---
import { projects } from '../lib/content';
import SectionHead from './SectionHead.astro';
import { asset } from '../lib/urls';

interface Props {
  index: number;
}
const { index } = Astro.props;

// این بخش فقط زمانی از صفحهٔ اصلی فراخوانی می‌شود که حداقل یک نمونه‌کار
// منتشرشده وجود داشته باشد. اگر فهرست خالی باشد، چیزی رندر نمی‌شود.
---

{projects.length > 0 && (
<section class="section section--paper-2" id="projects" aria-labelledby="projects-heading">
  <div class="wrap">
    <SectionHead index={index} title="نمونه‌کارها" labelEn="Projects" id="projects-heading" />
    <div class="projects">
      {
        projects.map((project, i) => (
          <article class="project" data-reveal style={`--reveal-delay:${i % 3}`}>
            <div class="project__media">
              {project.cover_image ? (
                <img
                  src={asset(project.cover_image)}
                  alt={`تصویر نمونه‌کار ${project.title}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="project__placeholder" aria-hidden="true">
                  <span>{project.year_label}</span>
                </div>
              )}
            </div>
            <div class="project__body">
              <h3 class="project__title">{project.title}</h3>
              {project.summary && <p class="project__summary">{project.summary}</p>}
              <div class="exp__meta">
                {project.status && <span class="chip chip--copper">{project.status}</span>}
                {project.year_label && <span class="chip">{project.year_label}</span>}
                {project.technologies.map((tech) => (
                  <span class="chip" lang="en" dir="ltr">
                    {tech}
                  </span>
                ))}
              </div>
              <div class="project__links">
                {project.demo_url && (
                  <a class="link-underline" href={project.demo_url} rel="noopener noreferrer" target="_blank">
                    مشاهدهٔ آنلاین ↗
                  </a>
                )}
                {project.source_url && (
                  <a class="link-underline" href={project.source_url} rel="noopener noreferrer" target="_blank">
                    کد منبع ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
)}
