---
import { fa } from '../lib/digits';

interface Props {
  index: number;
  title: string;
  aside?: string;
  id?: string;
}

const { index, title, aside = '', id = '' } = Astro.props;
---

<header class="sh">
  <p class="sh__num" aria-hidden="true">{fa(String(index).padStart(2, '0'))}</p>
  <h2 class="sh__title" id={id || undefined}>{title}</h2>
  {aside && <p class="sh__aside">{aside}</p>}
</header>
