---
import { site, activeSections } from '../lib/content';
import { asset } from '../lib/urls';

const sections = activeSections();
const enIndex: Record<string, string> = {
  about: 'About',
  skills: 'Skills',
  experience: 'Experience',
  projects: 'Projects',
  education: 'Education',
  contact: 'Contact',
};
const resumeHref = asset('/resume/');
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={asset('/')} aria-label={`${site.identity.name_fa} — صفحهٔ اصلی`}>
      <svg class="brand__mark" viewBox="0 0 32 40" fill="none" aria-hidden="true">
        <path
          d="M1 39V17.5C1 8.4 7.7 1 16 1s15 7.4 15 16.5V39"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"></path>
        <circle cx="16" cy="25" r="2.6" fill="#b4522a"></circle>
      </svg>
      <span class="brand__text">
        <span class="brand__name">{site.identity.name_fa}</span>
        <span class="brand__latin">{site.identity.name_en}</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="بخش‌های صفحه">
      <ul>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`} data-nav-link={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn--solid" href={resumeHref}>
        رزومهٔ چاپی
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 3.5 5.5 8l4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <details class="nav-drawer">
      <summary aria-label="فهرست بخش‌ها">فهرست</summary>
      <div class="nav-drawer__panel">
        <nav aria-label="فهرست بخش‌ها (موبایل)">
          <ul>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>
                    <span>{section.label}</span>
                    <span>{enIndex[section.id]}</span>
                  </a>
                </li>
              ))
            }
            <li class="nav-drawer__cta">
              <a href={resumeHref}>
                <span>رزومهٔ چاپی</span>
                <span>Resume</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
  <div class="progress-rail" aria-hidden="true"><i id="read-progress"></i></div>
</header>

<script>
  const header = document.getElementById('site-header');
  const progress = document.getElementById('read-progress');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const drawer = document.querySelector<HTMLDetailsElement>('.nav-drawer');

  let queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      const y = window.scrollY;
      header?.classList.toggle('is-stuck', y > 12);
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
      progress?.style.setProperty('--read', String(ratio));
    });
  }

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  // بخش فعال در فهرست
  const targets = links
    .map((link) => ({
      link,
      section: document.getElementById(link.dataset.navLink || ''),
    }))
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => !!entry.section);

  if ('IntersectionObserver' in window && targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const target = targets.find((item) => item.section === entry.target);
          if (!target) return;
          if (entry.isIntersecting) {
            links.forEach((link) => link.removeAttribute('aria-current'));
            target.link.setAttribute('aria-current', 'true');
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    targets.forEach((target) => observer.observe(target.section));
  }

  // بستن فهرست موبایل پس از انتخاب یک بخش
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      drawer.open = false;
    }),
  );

  document.addEventListener('click', (event) => {
    if (drawer?.open && !drawer.contains(event.target as Node)) drawer.open = false;
  });
</script>
