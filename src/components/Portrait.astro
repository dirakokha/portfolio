---
import { site } from '../lib/content';
import { asset } from '../lib/urls';

const { portrait_image, portrait_alt, portrait_caption } = site.hero;

/**
 * نسخه‌های ریسپانسیو فقط برای تصویر پیش‌فرض سایت ساخته شده‌اند.
 * اگر مالک سایت از پنل تصویر دیگری بارگذاری کند، همان تک‌فایل استفاده می‌شود
 * تا هیچ آدرس شکسته‌ای در srcset نماند.
 */
const hasResponsiveSet = /^\/media\/portrait-960\.webp$/.test(portrait_image);
const small = portrait_image.replace('-960', '-480');

/**
 * نشان‌های شناور کنار پرتره.
 * فقط چیزهایی که در بخش مهارت‌ها هم با همان وضعیت آمده‌اند؛ هیچ ادعای تازه‌ای اینجا ساخته نمی‌شود.
 * برای صفحه‌خوان‌ها پنهان‌اند، چون همین فهرست در بخش مهارت‌ها با توضیح کامل آمده است.
 */
const stack = [
  { label: 'HTML', talk: 'html' },
  { label: 'CSS', talk: 'css' },
  { label: 'JavaScript', talk: 'js' },
  { label: 'Python', talk: 'py' },
];

// بدون تصویر واقعی، هیچ قاب یا چهرهٔ ساختگی نمایش داده نمی‌شود؛
// بخش نخست در آن حالت کاملاً تایپوگرافی است.
---

{
  portrait_image && (
    <figure class="portrait">
      <div class="portrait__stage">
        <span class="portrait__glow" aria-hidden="true" />
        <div class="portrait__frame">
          <img
            src={asset(portrait_image)}
            srcset={hasResponsiveSet ? `${asset(small)} 480w, ${asset(portrait_image)} 960w` : undefined}
            sizes={hasResponsiveSet ? '(max-width: 720px) 62vw, (max-width: 1080px) 34vw, 27vw' : undefined}
            alt={portrait_alt || `تصویر ${site.identity.name_fa}`}
            width={hasResponsiveSet ? '960' : undefined}
            height={hasResponsiveSet ? '1200' : undefined}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <ul class="stack" aria-hidden="true">
          {stack.map((item, i) => (
            <li class={`stack__item stack__item--${item.talk}`} style={`--i:${i}`}>
              <span class="stack__chip">
                <span class="stack__dot" />
                <span class="stack__label" dir="ltr" lang="en">
                  {item.label}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      {portrait_caption && <figcaption>{portrait_caption}</figcaption>}
    </figure>
  )
}
