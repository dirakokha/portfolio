---
import { site } from '../lib/content';
import { asset } from '../lib/urls';

const { portrait_image, portrait_alt, portrait_caption } = site.hero;
---

<div class="arch">
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
      <clipPath id="archClip" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.5 A0.5,0.345 0 0 1 1,0.5 L1,1 Z"></path>
      </clipPath>
    </defs>
  </svg>

  <div class="arch__frame">
  <div class="arch__media">
    {
      portrait_image ? (
        <img
          src={asset(portrait_image)}
          alt={portrait_alt || `تصویر ${site.identity.name_fa}`}
          width="900"
          height="1200"
          loading="eager"
          decoding="async"
        />
      ) : (
        <svg
          class="arch__art"
          viewBox="0 0 300 400"
          preserveAspectRatio="xMidYMid slice"
          direction="ltr"
          role="img"
          aria-label="جای‌نگهدار تصویر پرتره؛ ترکیب گرافیکی بدون تصویر واقعی"
        >
          <defs>
            <linearGradient id="phGrad" x1="0" y1="0" x2="0.6" y2="1">
              <stop offset="0" stop-color="#1a2f29"></stop>
              <stop offset="0.62" stop-color="#0e1c19"></stop>
              <stop offset="1" stop-color="#091312"></stop>
            </linearGradient>
            <pattern id="phDots" width="9" height="9" patternUnits="userSpaceOnUse">
              <circle cx="1.1" cy="1.1" r="1.1" fill="rgba(247,242,231,0.30)"></circle>
            </pattern>
          </defs>
          <rect width="300" height="400" fill="url(#phGrad)"></rect>
          <rect x="212" y="26" width="66" height="74" fill="url(#phDots)" opacity="0.55"></rect>

          <g fill="none" stroke="rgba(247,242,231,0.10)" stroke-width="1">
            <circle cx="150" cy="352" r="56"></circle>
            <circle cx="150" cy="352" r="86"></circle>
            <circle cx="150" cy="352" r="118"></circle>
            <circle cx="150" cy="352" r="152"></circle>
            <circle cx="150" cy="352" r="190"></circle>
          </g>
          <circle
            cx="150"
            cy="352"
            r="118"
            fill="none"
            stroke="rgba(180,82,42,0.62)"
            stroke-width="1"
            stroke-dasharray="2 7"
          ></circle>

          <g stroke="rgba(180,82,42,0.5)" stroke-width="1">
            <line x1="150" y1="24" x2="150" y2="118"></line>
          </g>
          <circle cx="150" cy="24" r="2.4" fill="#b4522a"></circle>

          <g font-family="'Space Grotesk', sans-serif" fill="rgba(247,242,231,0.5)" letter-spacing="2">
            <text x="24" y="382" font-size="7">FIG. 01 — PORTRAIT</text>
            <text x="24" y="392" font-size="6" fill="rgba(247,242,231,0.3)">ROUDHEN / TEHRAN</text>
          </g>

          <g
            font-family="'Space Grotesk', sans-serif"
            font-size="30"
            letter-spacing="4"
            fill="rgba(247,242,231,0.82)"
          >
            <text x="150" y="196" text-anchor="middle">AK</text>
          </g>
          <line x1="112" y1="212" x2="188" y2="212" stroke="rgba(247,242,231,0.26)" stroke-width="1"></line>
          <text
            x="150"
            y="232"
            text-anchor="middle"
            font-family="'Vazirmatn', sans-serif"
            font-size="9"
            fill="rgba(247,242,231,0.55)"
          >جای تصویر شما</text>
        </svg>
      )
    }
  </div>

  <svg
    class="arch__outline"
    viewBox="0 0 300 400"
    preserveAspectRatio="none"
    aria-hidden="true"
    fill="none"
  >
    <path d="M1,399 L1,200 A149,138 0 0 1 299,200 L299,399" stroke="rgba(247,242,231,0.28)" stroke-width="1"></path>
    <path d="M22,399 L22,202 A128,118 0 0 1 278,202 L278,399" stroke="rgba(247,242,231,0.13)" stroke-width="1"></path>
    <line x1="1" y1="399" x2="299" y2="399" stroke="rgba(180,82,42,0.85)" stroke-width="2"></line>
    <line x1="150" y1="399" x2="150" y2="374" stroke="rgba(247,242,231,0.22)" stroke-width="1"></line>
  </svg>
  </div>

  <div class="arch__caption">
    <span>{portrait_caption || 'تصویر پرتره به‌زودی'}</span>
    <span class="latin">PORTRAIT / ۱۴۰۴</span>
  </div>
</div>
