---
import { about } from '../lib/content';
import SectionHead from './SectionHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap">
    <SectionHead index={index} title={about.title} labelEn={about.label_en} id="about-heading" />
    <div class="about">
      <div>
        <p class="about__lead" data-reveal>{about.lead}</p>
        <div class="about__body">
          {
            about.paragraphs.map((paragraph, i) => (
              <p data-reveal style={`--reveal-delay:${i + 1}`}>
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
      <div class="about__side">
        {
          about.facts.length > 0 && (
            <dl class="about__facts" data-reveal>
              {about.facts.map((fact) => (
                <div class="about__fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {about.quote && (
          <blockquote class="about__quote" data-reveal style="--reveal-delay:1">
            {about.quote}
          </blockquote>
        )}
      </div>
    </div>
  </div>
</section>
