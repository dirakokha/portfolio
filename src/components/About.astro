---
import { about } from '../lib/content';
import EntryHead from './EntryHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="entry" id="about" aria-labelledby={`head-${index}`} data-entry>
  <div class="wrap entry__grid">
    <EntryHead index={index} title={about.title} meta="ENTRY / ABOUT" />

    <div class="entry__body">
      {about.lead && <p class="entry__lead" data-mask>{about.lead}</p>}

      <div class="prose">
        {about.paragraphs.map((paragraph, i) => (
          <p data-reveal style={`--delay: ${i * 40}ms`}>{paragraph}</p>
        ))}
      </div>

      {
        about.facts.length > 0 && (
          <dl class="facts">
            {about.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
