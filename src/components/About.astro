---
import { about } from '../lib/content';
import SectionHead from './SectionHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap section__grid">
    <SectionHead index={index} title={about.title} id="about-heading" aside="کوتاه دربارهٔ مسیر و تمرکز فعلی" />

    <div class="section__body">
      {about.lead && <p class="lead" data-reveal>{about.lead}</p>}

      <div class="prose">
        {
          about.paragraphs.map((paragraph, i) => (
            <p data-reveal style={`--i:${i}`}>
              {paragraph}
            </p>
          ))
        }
      </div>

      {
        about.facts.length > 0 && (
          <dl class="facts" data-reveal>
            {about.facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

    </div>
  </div>
</section>
