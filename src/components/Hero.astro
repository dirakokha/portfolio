---
import { site, about, contact } from '../lib/content';
import { asset, mailtoHref } from '../lib/urls';
import ArchPortrait from './ArchPortrait.astro';

const hero = site.hero;
const identity = site.identity;
const nameWords = identity.name_en.split(' ');
const tickerItems = hero.ticker
  .split('·')
  .map((item) => item.trim())
  .filter(Boolean);
const [firstName, ...rest] = identity.name_fa.split(' ');
const lastName = rest.join(' ');
---

<div class="intro" id="intro" hidden aria-hidden="true">
  <div class="intro__inner">
    <span class="intro__name">{identity.name_fa}</span>
    <span class="intro__latin">{identity.name_en}</span>
    <span class="intro__bar"><i></i></span>
  </div>
  <button class="intro__skip" type="button" id="intro-skip">رد کردن مقدمه</button>
</div>

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__content">
      <div class="hero__meta">
        {
          identity.available && (
            <span class="status-dot">{identity.availability_note || 'آمادهٔ همکاری'}</span>
          )
        }
        <span class="rule" aria-hidden="true"></span>
        <span class="eyebrow">{identity.location_en}, IR</span>
      </div>

      <p class="eyebrow eyebrow--fa">{hero.kicker}</p>

      <div class="hero__names">
        <h1 class="hero__name-fa" id="hero-title">
          {firstName}
          <span class="hero__surname">{lastName}</span>
        </h1>
        <p class="hero__name-en" lang="en" dir="ltr">
          {
            nameWords.map((word, index) => (
              <>
                <span>{word}</span>
                {index < nameWords.length - 1 && ' '}
              </>
            ))
          }
        </p>
      </div>

      <p class="hero__intro">{hero.intro}</p>

      <div class="hero__cta">
        <a class="btn btn--cream" href="#about" data-scroll>
          {hero.primary_cta_label}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M6 3.5 10.5 8 6 12.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          class="btn btn--ghost-cream"
          href={mailtoHref(contact.email, contact.email_subject)}
        >
          {hero.secondary_cta_label}
        </a>
      </div>

      {
        hero.highlights.length > 0 && (
          <dl class="hero__highlights">
            {hero.highlights.map((item) => (
              <div class="hero__highlight">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="hero__portrait" id="hero-portrait">
      <ArchPortrait />
    </div>
  </div>

  {
    tickerItems.length > 0 && (
      <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
          {[0, 1, 2, 3].map((copy) => (
            <div class="ticker__group">
              {tickerItems.map((item) => (
                <>
                  <span>{item}</span>
                  <span class="sep">◆</span>
                </>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }

  <p class="sr-only">{about.lead}</p>
</section>

<script is:inline>
  (function () {
    var intro = document.getElementById('intro');
    var skip = document.getElementById('intro-skip');
    var html = document.documentElement;
    var done = false;

    function finish() {
      if (done) return;
      done = true;
      if (intro) {
        intro.setAttribute('hidden', '');
        intro.parentNode && intro.parentNode.removeChild(intro);
      }
      html.classList.remove('is-intro-open');
    }

    try {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var small = window.innerWidth < 760 || window.innerHeight < 520;
      var seen = false;
      try {
        seen = window.sessionStorage.getItem('akh-intro-seen') === '1';
      } catch (error) {
        seen = false;
      }
      if (intro && !reduced && !small && !seen) {
        intro.removeAttribute('hidden');
        intro.removeAttribute('aria-hidden');
        html.classList.add('is-intro-open');
        try {
          window.sessionStorage.setItem('akh-intro-seen', '1');
        } catch (error) {}
        intro.addEventListener('animationend', function (event) {
          if (event.animationName === 'intro-lift') finish();
        });
        if (skip) skip.addEventListener('click', finish);
        setTimeout(finish, 3600);
      }
    } catch (error) {
      finish();
    }
  })();
</script>

<script>
  // پیوندهای داخلی با درنظرگرفتن تنظیم کاهش حرکت
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('href');
      if (!id || !id.startsWith('#')) return;
      const target = document.querySelector(id);
      if (!target) return;
      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', id);
    });
  });

  // ژرفانمایی ملایم در بخش نخست
  const portrait = document.getElementById('hero-portrait');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (portrait && !reduce.matches && window.matchMedia('(min-width: 861px)').matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const offset = Math.min(window.scrollY, window.innerHeight);
      portrait.style.transform = `translate3d(0, ${(offset * 0.06).toFixed(2)}px, 0)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!raf) raf = requestAnimationFrame(update);
      },
      { passive: true },
    );
  }
</script>
