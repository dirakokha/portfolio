---
import { site, contact } from '../lib/content';
import { asset, mailtoHref } from '../lib/urls';
import { faYear } from '../lib/digits';
import Arrow from './Arrow.astro';

const identity = site.identity;
const hero = site.hero;
const resumeHref = asset('/resume/');
const mailTo = mailtoHref(contact.email, contact.email_subject);

const kickerItems = hero.kicker
  .split(/[—–]/)
  .map((item) => item.trim())
  .filter(Boolean);

const [firstName, ...rest] = identity.name_fa.split(' ');
const lastName = rest.join(' ');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__top wrap">
    <p class="hero__status">
      {identity.available && <span class="dot" aria-hidden="true" />}
      <span>{identity.available ? identity.availability_note || 'آمادهٔ همکاری' : identity.role_fa}</span>
    </p>
    <p class="hero__year" dir="ltr">{faYear(new Date())} / PORTFOLIO</p>
  </div>

  <div class="hero__mid wrap">
    {
      kickerItems.length > 0 && (
        <p class="hero__kicker">
          {kickerItems.map((item) => (
            <span>{item}</span>
          ))}
        </p>
      )
    }

    <h1 class="hero__title" id="hero-title">
      <span class="hero__line"><span data-mask>{firstName}</span></span>
      <span class="hero__line hero__line--out"><span data-mask style="--delay: 0.08s">{lastName}</span></span>
    </h1>
    <p class="hero__latin" dir="ltr">{identity.name_en}</p>
  </div>

  <div class="hero__foot wrap">
    <p class="hero__intro">{hero.intro}</p>

    <div class="hero__actions">
      <a class="btn" href={resumeHref}>
        {hero.primary_cta_label}
        <Arrow dir="forward" />
      </a>
      <a class="link-line" href={mailTo}>{hero.secondary_cta_label}</a>
    </div>

    {
      hero.highlights.length > 0 && (
        <dl class="hero__facts">
          {hero.highlights.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
