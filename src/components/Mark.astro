---
/**
 * نشان سایت — یک شش‌گوش با گرهٔ مرکزی و سه بازو.
 * فقط شکل است، بدون حرف؛ هم در هدر کوچک خوانا می‌ماند و هم به‌عنوان آیکون.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: klass = '' } = Astro.props;
---

<svg
  class={`mark ${klass}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <polygon
    points="16,3.5 26.8,9.75 26.8,22.25 16,28.5 5.2,22.25 5.2,9.75"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linejoin="round"></polygon>
  <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.5">
    <path d="M16 16V3.9"></path>
    <path d="m16 16 10.4 6"></path>
    <path d="m16 16-10.4 6"></path>
  </g>
  <circle cx="16" cy="16" r="3.1" fill="var(--accent, #8b322c)"></circle>
  <circle cx="16" cy="3.9" r="1.5" fill="currentColor"></circle>
  <circle cx="26.4" cy="22" r="1.5" fill="currentColor"></circle>
  <circle cx="5.6" cy="22" r="1.5" fill="currentColor"></circle>
</svg>
