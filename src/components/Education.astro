---
import { education, certifications } from '../lib/content';
import SectionHead from './SectionHead.astro';
import { asset } from '../lib/urls';
import Arrow from './Arrow.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;
---

<section class="section" id="education" aria-labelledby="education-heading">
  <div class="wrap section__grid">
    <SectionHead
      index={index}
      title="تحصیلات و گواهینامه‌ها"
      id="education-heading"
      aside="مدرک و دوره‌های واقعی؛ گواهی‌ای که وجود ندارد نمایش داده نمی‌شود."
    />

    <div class="section__body">
      <div class="edu-grid">
      <section class="edu" data-reveal style="--i:0">
        <h3 class="edu__label">تحصیلات</h3>
        {
          education.items.map((item) => (
            <article class="edu__item">
              <h4 class="edu__field">{item.field}</h4>
              <p class="edu__line">
                {item.degree}
                {item.institution && <span> — {item.institution}</span>}
              </p>
              <p class="edu__meta">
                {item.status && <span class="is-strong">{item.status}</span>}
                {item.period_label && item.period_label !== item.status && <span>{item.period_label}</span>}
                {item.location && <span>{item.location}</span>}
              </p>
              {item.note && <p class="edu__note">{item.note}</p>}
            </article>
          ))
        }
        {education.items.length === 0 && <p class="edu__note">موردی ثبت نشده است.</p>}
      </section>

      <section class="edu" data-reveal style="--i:1">
        <h3 class="edu__label">دوره‌ها و گواهینامه‌ها</h3>
        {
          certifications.items.map((cert) => (
            <article class="edu__item">
              <h4 class="edu__field">{cert.title}</h4>
              <p class="edu__line">
                {cert.provider}
                {cert.year_label && <span> — {cert.year_label}</span>}
              </p>
              {cert.status && (
                <p class="edu__meta">
                  <span class="is-strong">{cert.status}</span>
                </p>
              )}
              {cert.note && <p class="edu__note">{cert.note}</p>}
              {cert.credential_url && (
                <a
                  class="link-line"
                  href={cert.credential_url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  صفحهٔ تأیید گواهی
                  <Arrow dir="external" />
                </a>
              )}
              {cert.certificate_file && (
                <a
                  class="link-line"
                  href={asset(cert.certificate_file)}
                  target="_blank"
                  rel="noopener"
                >
                  مشاهدهٔ فایل گواهی
                  <Arrow dir="external" />
                </a>
              )}
            </article>
          ))
        }
        {certifications.items.length === 0 && <p class="edu__note">موردی ثبت نشده است.</p>}
      </section>
      </div>
    </div>
  </div>
</section>
