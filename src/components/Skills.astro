---
import { skills, stateLabels } from '../lib/content';
import SectionHead from './SectionHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;

const legend = [
  { state: 'working', label: 'در کار واقعی' },
  { state: 'course', label: 'دوره دیده‌شده' },
  { state: 'learning', label: 'در حال یادگیری' },
  { state: 'academic', label: 'دانش آکادمیک' },
  { state: 'familiar', label: 'آشنایی مقدماتی' },
];
---

<section class="section" id="skills" aria-labelledby="skills-heading">
  <div class="wrap section__grid">
    <SectionHead
      index={index}
      title="مهارت‌ها"
      id="skills-heading"
      aside="برای هر مهارت یک وضعیت واقعی ثبت شده است؛ نمره و درصد در کار نیست."
    />

    <div class="section__body">
      <div class="skills">
        {
          skills.categories.map((category) => (
            <section class="cat" data-reveal>
              <header class="cat__head">
                <h3 class="cat__title">{category.title}</h3>
                {category.note && <p class="cat__note">{category.note}</p>}
              </header>
              <ul class="cat__list">
                {category.items.map((skill) => (
                  <li class="skill">
                    <span class="skill__name">
                      {skill.name}
                      {skill.name_en && (
                        <span class="skill__en" lang="en" dir="ltr">
                          {skill.name_en}
                        </span>
                      )}
                    </span>
                    <span class="skill__lead" aria-hidden="true"></span>
                    <span class={`skill__state is-${skill.state}`}>
                      {stateLabels[skill.state]}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <ul class="legend" aria-label="راهنمای وضعیت مهارت‌ها">
        {
          legend.map((item) => (
            <li class={`is-${item.state}`}>
              <i aria-hidden="true" />
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
