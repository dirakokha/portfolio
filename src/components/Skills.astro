---
import { skills } from '../lib/content';
import EntryHead from './EntryHead.astro';

interface Props {
  index: number;
}
const { index } = Astro.props;

const stateLabels: Record<string, string> = {
  working: 'در کار واقعی',
  course: 'دوره گذرانده',
  learning: 'در حال یادگیری',
  familiar: 'آشنایی مقدماتی',
  academic: 'دانش آکادمیک',
};
---

<section class="entry" id="skills" aria-labelledby={`head-${index}`} data-entry>
  <div class="wrap entry__grid">
    <EntryHead index={index} title="مهارت‌ها" meta="ENTRY / SKILLS" />

    <div class="entry__body">
      <div class="spec">
        {
          skills.categories.map((category) => (
            <div class="spec__cat">
              <div class="spec__title">
                <h3>{category.title}</h3>
                {category.note && <p>{category.note}</p>}
              </div>
              <dl class="spec__list">
                {category.items.map((item) => (
                  <div class="spec__item">
                    <dt class="spec__name">
                      <span>{item.name}</span>
                      {item.name_en && <span class="spec__en">{item.name_en}</span>}
                      <span class={`state state--${item.state}`}>{stateLabels[item.state]}</span>
                    </dt>
                    {item.context && <dd>{item.context}</dd>}
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
