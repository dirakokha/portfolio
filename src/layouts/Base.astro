---
import '../styles/notebook.css';
import { site, contact, socialLinks } from '../lib/content';
import { asset, absolute } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  image = site.seo.og_image,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = absolute(image);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.identity.name_fa,
  alternateName: site.identity.name_en,
  jobTitle: site.identity.role_fa,
  description: site.seo.description,
  email: `mailto:${contact.email}`,
  url: canonical.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'رودهن',
    addressRegion: 'تهران',
    addressCountry: 'IR',
  },
  knowsLanguage: ['fa', 'en'],
  knowsAbout: ['پشتیبانی فناوری اطلاعات', 'نصب ویندوز', 'عیب‌یابی سخت‌افزار', 'Python', 'HTML', 'CSS'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'دانشگاه علمی‌کاربردی گسترش انفورماتیک ایران',
  },
  ...(socialLinks.length ? { sameAs: socialLinks.map((social) => social.url) } : {}),
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.seo.keywords && <meta name="keywords" content={site.seo.keywords} />}
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content={site.identity.name_fa} />
    <meta name="theme-color" content="#0d0b0a" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.identity.name_fa} />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`کارت معرفی ${site.identity.name_fa}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />

    <link
      rel="preload"
      href={asset('/fonts/Vazirmatn-Variable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={asset('/fonts/Estedad-Variable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <script is:inline>
      (function () {
        var html = document.documentElement;
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (!('IntersectionObserver' in window)) return;
          html.classList.add('js');
        } catch (error) {
          /* بدون جاوااسکریپت هم همه‌چیز خوانده می‌شود */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>
    <slot />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal], [data-mask], [data-entry]'),
      );

      // ظاهر شدن هنگام رسیدن به بخش
      if (targets.length && 'IntersectionObserver' in window && !reduceMotion.matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          // آستانه صفر: عنصرهای دارای clip-path در لحظهٔ ورود نسبت صفر دارند
          { rootMargin: '0px 0px -10% 0px', threshold: 0 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }

      // رنگ هدر و ریل بر اساس بخشی که زیر آن است + شمارهٔ بخش فعال
      const header = document.getElementById('site-header');
      const rail = document.getElementById('rail');
      const hero = document.querySelector<HTMLElement>('.hero');
      const contact = document.querySelector<HTMLElement>('.contact');
      const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-entry]'));
      const railLinks = new Map<string, HTMLElement>();
      rail?.querySelectorAll<HTMLElement>('[data-rail]').forEach((link) => {
        railLinks.set(link.dataset.rail || '', link);
      });

      let queued = false;

      function paint() {
        queued = false;
        const y = window.scrollY;
        const probe = y + window.innerHeight * 0.38;

        const heroBottom = hero ? hero.offsetHeight - 40 : 0;
        const contactTop = contact ? contact.offsetTop - 80 : Number.POSITIVE_INFINITY;
        const overDark = y < heroBottom || y > contactTop;

        header?.classList.toggle('is-paper', !overDark && y > 24);
        header?.classList.toggle('is-dark', overDark && y > 24);
        rail?.classList.toggle('is-on-night', overDark);

        let activeId = 'about';
        entries.forEach((entry) => {
          if (entry.offsetTop <= probe) activeId = entry.id;
        });
        if (contact && contact.offsetTop <= probe) activeId = 'contact';

        railLinks.forEach((link, id) => link.classList.toggle('is-active', id === activeId));
      }

      function queue() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(paint);
      }

      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue, { passive: true });
      paint();
    </script>
  </body>
</html>
