---
import Base from '../layouts/Base.astro';
import { site } from '../lib/content';
import { asset } from '../lib/urls';
---

<Base
  title={`صفحه پیدا نشد — ${site.identity.name_fa}`}
  description="این نشانی در سایت وجود ندارد."
  noindex
>
  <main id="main" class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">۴۰۴</p>
    <h1>این صفحه خالی است</h1>
    <p>
      نشانی‌ای که باز کردید وجود ندارد یا جابه‌جا شده است. می‌توانید به صفحهٔ اصلی برگردید یا
      رزومهٔ چاپی را ببینید.
    </p>
    <div class="notfound__actions">
      <a class="btn" href={asset('/')}>صفحهٔ اصلی</a>
      <a class="link-line" href={asset('/resume/')}>رزومهٔ چاپی</a>
    </div>
  </main>
</Base>
