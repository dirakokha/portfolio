---
import Base from '../layouts/Base.astro';
import { site } from '../lib/content';
import { asset } from '../lib/urls';
---

<Base title={`صفحه پیدا نشد — ${site.identity.name_fa}`} description="این نشانی در سایت وجود ندارد." noindex>
  <main id="main" class="nf">
    <div class="nf__inner">
      <p class="nf__code" aria-hidden="true">۴۰۴</p>
      <h1 class="nf__title">این صفحه خالی است</h1>
      <p class="nf__text">
        نشانی‌ای که باز کردید وجود ندارد یا جابه‌جا شده است. می‌توانید به صفحهٔ اصلی برگردید یا رزومهٔ
        چاپی را ببینید.
      </p>
      <div class="nf__actions">
        <a class="btn btn--solid" href={asset('/')}>صفحهٔ اصلی</a>
        <a class="btn" href={asset('/resume/')}>رزومهٔ چاپی</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 8vw, 5rem) var(--gutter);
    background: var(--paper);
  }

  .nf__inner {
    max-width: 34rem;
  }

  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 14vw, 8rem);
    line-height: 1;
    color: var(--copper);
    margin: 0 0 0.75rem;
  }

  .nf__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
  }

  .nf__text {
    color: var(--muted);
    margin: 0 0 1.75rem;
    max-width: 42ch;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
